; The main module is [main] rather than [market_maker] so that it does not clash with
; the [market_maker] library's wrapper module.

(executable
 (name main)
 (public_name market-maker)
 (modules main)
 (libraries
  async
  core
  core_unix.command_unix
  core_unix.filename_unix
  exchange-core
  market-maker
  mm-core
  uri)
 (preprocess
  (pps ppx_jane)))

; Used by scripts/compare-venues.sh, not installed.

(executable
 (name venue_script)
 (modules venue_script)
 (libraries
  async
  core
  core_unix.command_unix
  exchange-core
  hl-protocol
  hl-client
  hl-mm
  binance-client
  market-maker
  mm-core
  uri)
 (preprocess
  (pps ppx_jane)))

; A Bonsai_term prototype; built only where bonsai_term is installed.

(executable
 (name status_viewer)
 (public_name market-maker-status)
 (package market-maker)
 (optional)
 (modules status_viewer)
 (libraries
  async
  bonsai
  bonsai_term
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  market-maker)
 (preprocess
  (pps ppx_jane)))
